# 交易猫回收订单抓取配置模板
# 复制本文件为 configs/config.yaml 并填写真实值：
#   cp configs/config.yaml.example configs/config.yaml
# config.yaml 包含敏感信息，已被 .gitignore 忽略；请勿提交真实凭据。

jiaoyimao:
  base_url: "https://merchant.jiaoyimao.com"
  username: "YOUR_PHONE_OR_EMAIL"   # TODO: 替换为交易猫账号
  password: "YOUR_PASSWORD"         # TODO: 替换为交易猫密码
  cookie_path: "./data/cookies.json"
  login_type: "password"            # "password" 密码登录 | "sms" 短信验证码登录

feishu:
  app_id: "cli_xxxxxxxxxxxx"        # TODO: 替换为飞书应用 App ID
  app_secret: "xxxxxxxxxxxxxxxxxxxxxxxxxx"  # TODO: 替换为飞书应用 App Secret
  bitable_id: "GzGfb0UECaWsjPsiEgScFnqqnQn"  # 多维表格 app_token
  board_table_id: "tbl9GnWtSkuMzIoV"         # 看板统计数据表 table_id
  table_mapping:                            # 订单方案遗留（本阶段看板不使用）
    "火影忍者": "tblXXXXXXX1"
    "原神_table1": "tblXXXXXXX2"
    "原神_table2": "tblXXXXXXX3"
    "绝区零": "tblXXXXXXX4"
    "崩坏：星穹铁道_table1": "tblXXXXXXX5"
    "崩坏：星穹铁道_table2": "tblXXXXXXX6"
    "鸣潮": "tblXXXXXXX7"
    "三角洲行动": "tblXXXXXXX8"

browser:
  headless: true           # Rod 无头浏览器；不加反检测
  chrome_path: ""          # 留空则自动查找系统 Chrome
  timeout_sec: 120
  debug_port: 9222

scraper:
  mode: "api"             # api: 仅 API 抓取看板统计
  cron_expr: "0 9 * * *"  # 每天 9:00 执行
  stats_dir: "./data/stats"
  games:
    - name: "火影忍者"
      url: "/workbench/recycle/naruto"
      table_count: 1
    - name: "原神"
      url: "/workbench/recycle/genshin"
      table_count: 2
    - name: "绝区零"
      url: "/workbench/recycle/zzz"
      table_count: 1
    - name: "崩坏：星穹铁道"
      url: "/workbench/recycle/hsr"
      table_count: 2
    - name: "鸣潮"
      url: "/workbench/recycle/wuthering"
      table_count: 1
    - name: "三角洲行动"
      url: "/workbench/recycle/deltaforce"
      table_count: 1
    - name: "和平精英"
      url: "/workbench/recycle/peace"
      table_count: 1
    - name: "王者荣耀"
      url: "/workbench/recycle/wangzhe"
      table_count: 1

captcha:
  provider: "opencv"       # 优先使用 OpenCV 本地识别
  api_key: ""              # 备用第三方平台密钥（TODO: 如需使用则填写）
  max_retry: 3

# Web 状态仪表盘（-web 参数启用）
web:
  addr: "127.0.0.1:8080"   # 监听地址，仅本地可访问；设为 "0.0.0.0:8080" 可远程访问

# 结构化日志（log/slog）
log:
  level: "info"              # debug | info | warn | error
  file: "./data/scraper.log" # 日志文件路径，留空则仅输出到控制台
  max_size_mb: 10            # 单文件大小上限（MB），超限自动轮转
  max_backups: 3             # 保留的轮转文件数

# leyoo third_account / third_password 解密（AES-128-ECB）
# 密钥不要提交到 Git；也可用环境变量 THIRDPARTYSYNC_AES_KEY
credential:
  aes_key: ""                # 16 字节密钥；空则读环境变量
